DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/facturas
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Si se define, las sugerencias de cuenta contable usan OpenRouter en vez de Claude.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=google/gemini-2.5-flash

# Obligatoria: firma las sesiones y la app no arranca sin ella. Generala con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

USUARIO_INICIAL_CONTADORA_CLAVE=
USUARIO_INICIAL_ADMIN_CLAVE=

# Integracion Factible (descarga de facturas RECIBIDAS). FACTIBLE_MODO: real | simulador | vacio (desactivada)
# Host QA: hasta mediados de nov-2026 qa-webinterno.esfactible.com; despues https://qa-api.esfactible.com
FACTIBLE_MODO=
FACTIBLE_URL_BASE=https://qa-api.esfactible.com
FACTIBLE_USUARIO=
FACTIBLE_CLAVE=
FACTIBLE_RUC=
FACTIBLE_DESCARGA_AUTOMATICA=true
FACTIBLE_HORA_DESCARGA=07:00
FACTIBLE_INTERVALO_CONSULTA=30

# Envio a SAP Business One. SAP_MODO: simulador (por defecto) | servicelayer
# Valores FALSOS de ejemplo: las credenciales reales van solo en .env, nunca aqui.
SAP_MODO=simulador
SAP_URL_BASE=https://sap.ejemplo.invalid:50000/b1s/v2/
SAP_COMPANY_DB=SBO_EJEMPLO
SAP_USUARIO=usuario-falso
SAP_CLAVE=clave-falsa
SAP_VERIFICAR_TLS=true
# HIPOTESIS sin verificar: comprobar con el $metadata del SAP real antes de usarlas (ver README).
SAP_CAMPO_RUC_PROVEEDOR=FederalTaxID
SAP_CAMPO_CUENTA_LINEA=AccountCode
SAP_CAMPO_NUMERO_FACTURA=NumAtCard
